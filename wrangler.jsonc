{
  // Cloudflare Workers: a small Worker handles /api/ (accounts and saved gardens, stored in D1);
  // everything else is served from the built site in dist/.
  // "name" must match the project name shown in the Cloudflare dashboard.
  "name": "homegrown-plate",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "homegrown-plate", "database_id": "00b0e4ea-eb36-4bc7-ace3-04040864ec3a", "migrations_dir": "migrations" }
  ]
}
